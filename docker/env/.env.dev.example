# ============ 开发环境环境变量 ============

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=dev_root_123456
MYSQL_DATABASE=privrag_dev
MYSQL_USER=privrag
MYSQL_PASSWORD=privrag_dev_123456
MYSQL_HOST=mysql
MYSQL_PORT=3306
# MYSQL_HOST_PORT: MySQL 映射到宿主机的端口
MYSQL_HOST_PORT=6666

# ---------- Qdrant ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=privrag_dev

# ---------- DashScope ----------
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---------- 模型加载模式：remote=远程 / local=本地 ----------
MODEL_MODE=remote

# ---------- 远程模式：OpenAI 协议聊天模型 ----------
# 通义兼容端点: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:     https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_API_KEY=<your_openai_compatible_api_key>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 本地模式：Ollama ----------
# OLLAMA_PORT: Ollama 映射到宿主机的端口（11434 被 Windows 保留段占用，改用 21434）
# Docker 编排内为 http://ollama:11434；宿主机直连为 http://localhost:21434
OLLAMA_PORT=21434
OLLAMA_BASE_URL=http://ollama:11434

# ---------- 后端服务 ----------
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
