# ============ 开发环境环境变量 ============

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=dev_root_123456
MYSQL_DATABASE=privrag_dev
MYSQL_USER=privrag
MYSQL_PASSWORD=privrag_dev_123456
MYSQL_HOST=mysql
MYSQL_PORT=3306
# MYSQL_HOST_PORT: MySQL 映射到宿主机的端口（高位端口，降低端口占用概率）
MYSQL_HOST_PORT=16666

# ---------- Qdrant ----------
QDRANT_HOST=qdrant
# QDRANT_PORT: 容器内 HTTP 端口（backend 容器通过 qdrant:6333 访问，勿改）
QDRANT_PORT=6333
# QDRANT_HOST_PORT / QDRANT_GRPC_HOST_PORT: 映射到宿主机的端口（本地直跑用）
QDRANT_HOST_PORT=16333
QDRANT_GRPC_HOST_PORT=16334
QDRANT_COLLECTION=privrag_dev

# ---------- DashScope ----------
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---------- 模型加载模式：remote=远程 / local=本地 ----------
MODEL_MODE=remote

# ---------- 远程模式：OpenAI 协议聊天模型 ----------
# 可指向任意 OpenAI 协议供应商（通义兼容端点 / DeepSeek / 月之暗面等）
# 通义兼容端点: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:     https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_API_KEY=<your_openai_compatible_api_key>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 远程模式：可选模型覆盖（默认均走 DashScope，无需配置）----------
# 嵌入模型：默认取 backend/app/config/rag_config.yml 的 remote.embedding_model_name
# TEXT_EMBEDDING_MODEL=text-embedding-v4
# 精排模型：默认取 backend/app/config/retrieval_config.yml 的 rerank.remote_model
# RERANK_MODEL=gte-rerank-v2
# 评测模型（裁判/评测集生成）：默认 qwen-plus，与历史评测报告口径可比
# EVAL_CHAT_MODEL=qwen-plus
# DashScope OpenAI 协议兼容端点（仅评测模型使用）：默认为下方注释值
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 本地模式：Ollama ----------
# OLLAMA_PORT: Ollama 映射到宿主机的端口（11434 被 Windows 保留段占用，改用 21434）
# Docker 编排内为 http://ollama:11434；宿主机直连为 http://localhost:21434
OLLAMA_PORT=21434
OLLAMA_BASE_URL=http://ollama:11434

# ---------- 账号管理（管理员初始化 / 登录安全）----------
# ADMIN1_USERNAME / ADMIN1_PASSWORD：内置管理员账号与初始密码（必填）。
# 默认示例账号 admin，密码请自定义为 12 位以上强密码后使用。
# 首次启动时若账号不存在则自动创建（密码 bcrypt 哈希存储）；已存在则不会覆盖密码。
# 管理员密码仅用于初始化，修改请用命令行脚本（见 docs/账号管理说明文档.md）。
# 如需多个管理员，可继续配置 ADMIN2_USERNAME / ADMIN2_PASSWORD（最多 3 个）。
ADMIN1_USERNAME=admin
ADMIN1_PASSWORD=ChangeMe_Admin_2026
# ADMIN2_USERNAME=
# ADMIN2_PASSWORD=
# ADMIN3_USERNAME=
# ADMIN3_PASSWORD=

# 登录安全：连续失败次数上限与锁定时长（分钟）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# JWT 签名密钥：生产环境必须改为随机长字符串
SECRET_KEY=privrag-dev-secret-key-change-in-prod

# ---------- 后端服务 ----------
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
