# ============ 生产环境环境变量 ============

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=<strong_production_password>
MYSQL_DATABASE=privrag
MYSQL_USER=privrag
MYSQL_PASSWORD=<strong_production_password>
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---------- Qdrant ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=privrag

# ---------- DashScope ----------
DASHSCOPE_API_KEY=<your_dashscope_api_key>

# ---------- 后端服务 ----------
ENV=production
DEBUG=false
LOG_LEVEL=INFO
