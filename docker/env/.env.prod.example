# ============ 生产环境环境变量 ============

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=<strong_production_password>
MYSQL_DATABASE=privrag
MYSQL_USER=privrag
MYSQL_PASSWORD=<strong_production_password>
MYSQL_HOST=mysql
MYSQL_PORT=3306
# MYSQL_HOST_PORT: MySQL 映射到宿主机的端口（高位端口，降低端口占用概率）
MYSQL_HOST_PORT=16666

# ---------- Qdrant ----------
QDRANT_HOST=qdrant
# QDRANT_PORT: 容器内 HTTP 端口（backend 容器通过 qdrant:6333 访问，勿改）
QDRANT_PORT=6333
# QDRANT_HOST_PORT / QDRANT_GRPC_HOST_PORT: 映射到宿主机的端口（本地直跑用）
QDRANT_HOST_PORT=16333
QDRANT_GRPC_HOST_PORT=16334
QDRANT_COLLECTION=privrag

# ---------- DashScope ----------
DASHSCOPE_API_KEY=<your_dashscope_api_key>

# ---------- 模型加载模式：remote=远程 / local=本地 ----------
MODEL_MODE=remote

# ---------- 远程模式：OpenAI 协议聊天模型 ----------
# 可指向任意 OpenAI 协议供应商（通义兼容端点 / DeepSeek / 月之暗面等）
# 通义兼容端点: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:     https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_API_KEY=<your_openai_compatible_api_key>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 远程模式：可选模型覆盖（默认均走 DashScope，无需配置）----------
# 嵌入模型：默认取 backend/app/config/rag_config.yml 的 remote.embedding_model_name
# TEXT_EMBEDDING_MODEL=text-embedding-v4
# 精排模型：默认取 backend/app/config/retrieval_config.yml 的 rerank.remote_model
# RERANK_MODEL=gte-rerank-v2
# 评测模型（裁判/评测集生成）：默认 qwen-plus，与历史评测报告口径可比
# EVAL_CHAT_MODEL=qwen-plus
# DashScope OpenAI 协议兼容端点（仅评测模型使用）：默认为下方注释值
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 本地模式：Ollama ----------
# OLLAMA_PORT: Ollama 映射到宿主机的端口（11434 被 Windows 保留段占用，改用 21434）
# Docker 编排内为 http://ollama:11434；宿主机直连为 http://localhost:21434
OLLAMA_PORT=21434
OLLAMA_BASE_URL=http://ollama:11434

# ---------- 后端服务 ----------
ENV=production
DEBUG=false
LOG_LEVEL=INFO
