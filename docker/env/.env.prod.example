# ============ 生产环境环境变量 ============

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=<strong_production_password>
MYSQL_DATABASE=privrag
MYSQL_USER=privrag
MYSQL_PASSWORD=<strong_production_password>
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---------- Qdrant ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=privrag

# ---------- DashScope ----------
DASHSCOPE_API_KEY=<your_dashscope_api_key>

# ---------- 模型加载模式：remote=远程 / local=本地 ----------
MODEL_MODE=remote

# ---------- 远程模式：OpenAI 协议聊天模型 ----------
# 通义兼容端点: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:     https://api.deepseek.com/v1
OPENAI_API_KEY=<your_openai_compatible_api_key>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 本地模式：Ollama ----------
# Docker 编排内为 http://ollama:11434；宿主机直连为 http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# ---------- 后端服务 ----------
ENV=production
DEBUG=false
LOG_LEVEL=INFO
